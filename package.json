  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:debug": "cross-env NODE_OPTIONS=--inspect tsx watch src/server.ts",
    "build": "rimraf dist node_modules/.cache/tsbuildinfo && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--enable-source-maps node dist/server.js",
    "clean": "rimraf dist node_modules/.cache/tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "rebuild": "npm run clean && npm run build",
    "prepare": "husky"
  }
}
